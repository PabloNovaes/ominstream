# --- Obrigatório ---
ADDON_SECRET=                        # segredo da URL de instalação (16+ caracteres aleatórios)

# --- TorBox ---
TORBOX_API_KEY=
TORBOX_CLEANUP_REJECTED=true         # remove da conta torrents adicionados no play e reprovados

# --- Conversão de IDs do TMDB (catálogo "The Movie Database") para IMDb ---
TMDB_API_KEY=                        # chave gratuita: https://www.themoviedb.org/settings/api
META_ADDON_URL=                      # reserva (mais lenta): URL do manifesto do addon do TMDB

# --- Fontes: JSON com nome, URL do manifesto (com a config do addon) e peso ---
# trustLanguageTags=false ignora bandeiras/idiomas exibidos pela fonte (quando ela marca tudo igual)
SOURCES=[{"name":"Brazuca Torrents","url":"https://…/manifest.json","weight":1.5},{"name":"Magneto","url":"https://…/manifest.json","trustLanguageTags":false}]
SOURCE_TIMEOUT_MS=6000               # tempo máximo por addon
RESPONSE_BUDGET_MS=9000              # tempo máximo da resposta inteira

# --- Verificação de áudio ---
DEEP_VERIFY_MIN_RESOLUTION=2160      # a partir daqui: leitura real das faixas no play
PROBE_HTTP_BEFORE_LISTING=true       # links HTTP diretos são verificados já na listagem
HEURISTIC_MIN_SCORE=50               # limiar (0–100) para "PT-BR provável" (DUAL sozinho = 50)
ACCEPT_GENERIC_POR=true              # faixa "por" sem país conta como PT-BR
ACCEPT_PT_PT=false
BR_RELEASE_GROUPS=                   # grupos conhecidos, separados por vírgula (opcional)

# --- Saída ---
PLAY_MAX_ATTEMPTS=3
RESULTS_PER_RESOLUTION=2160:3,1080:3,720:1   # vagas por resolução na lista
